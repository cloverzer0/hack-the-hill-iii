# Copy to .env and fill in. Never commit .env.

# Gemini (news pipeline: build_news.py, make_images.py). Get one at https://aistudio.google.com/api-keys
# Images need a paid tier; the free tier allows 0 image requests.
GEMINI_API_KEY=

# Optional: Claude drafts headlines for data stories without a hand-written title (build_stories.py).
ANTHROPIC_API_KEY=

# Raphael's spending API, used by --push (build_stories.py, build_news.py).
SPENDING_API_URL=
INTERNAL_SECRET=
